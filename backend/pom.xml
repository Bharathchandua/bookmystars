<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.example</groupId>
	<artifactId>bookmystars-backend-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>bookmystars-backend-parent</name>
	<description>Aggregator for BookMyStars Admin and User Backends</description>

	<modules>
		<module>bmsAdminBackend</module>
		<module>bmsUserBackend</module>
	</modules>

	<build>
		<plugins>
			<!-- Clean the root deploy/ directory when running mvn clean -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.4.0</version>
				<configuration>
					<filesets>
						<fileset>
							<directory>${project.basedir}/deploy</directory>
							<includes>
								<include>**/*</include>
							</includes>
						</fileset>
					</filesets>
				</configuration>
			</plugin>

			<!-- Automatically collect all finished JARs into backend/deploy/ -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>collect-deploy-jars</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<mkdir dir="${project.basedir}/deploy" />
								<copy todir="${project.basedir}/deploy" flatten="true" failonerror="false">
									<fileset dir="${project.basedir}">
										<include name="bms*Backend/target/**/*.war" />
										<include name="bms*Backend/target/**/*.jar" />
										<exclude name="**/*.original" />
									</fileset>
								</copy>
								<echo message="==========================================================================" />
								<echo message=" [DEPLOY] Finished packaging! All deployable WAR &amp; JAR files copied to: ${project.basedir}/deploy" />
								<echo message="==========================================================================" />
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- 1. Local Development Profile (Default) -->
		<profile>
			<id>local</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
		</profile>

		<!-- 2. Staging / Testing Profile -->
		<profile>
			<id>stage</id>
		</profile>

		<!-- 3. Live Production Profile (Ready for CloudJiffy) -->
		<profile>
			<id>prod</id>
		</profile>
	</profiles>
</project>
